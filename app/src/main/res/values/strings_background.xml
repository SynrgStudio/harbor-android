<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Downloads screen and download errors -->
    <string name="downloads_title">Downloads</string>
    <string name="downloads_back">Back</string>
    <!-- Space taken by downloads and space left on the device, e.g. "Using 3.2 GB · 20.1 GB free". -->
    <string name="downloads_storage">Using %1$s · %2$s free</string>
    <string name="downloads_empty_title">No downloads</string>
    <string name="downloads_empty_text">In the streams list of a movie or episode, tap ⬇ to save it and watch offline.</string>
    <!-- Season and episode of a download, e.g. "S1 · E2". -->
    <string name="downloads_episode_label">S%1$d · E%2$d</string>
    <string name="downloads_options">Options</string>
    <string name="downloads_pause">Pause</string>
    <string name="downloads_resume">Resume</string>
    <string name="downloads_delete">Delete download</string>
    <string name="downloads_cancel">Cancel download</string>
